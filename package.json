{
  "name": "ai-prompt-manager",
  "version": "2.3.0",
  "private": true,
  "description": "Lokale Promptverwaltung als eigenständige HTML-Datei",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node serve.mjs",
    "open": "node serve.mjs --ensure",
    "autostart:install": "node scripts/install-autostart.mjs",
    "autostart:status": "node scripts/install-autostart.mjs --status",
    "autostart:uninstall": "node scripts/install-autostart.mjs --uninstall",
    "test": "node --test",
    "check": "node scripts/check.mjs",
    "verify": "npm run check && npm test"
  }
}
